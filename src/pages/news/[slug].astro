---
import Shell from "../../layouts/ShellWithNav.astro";
import { articles } from "../../lib/data";
import { img } from "../../lib/img";
import NewsCard from "../../components/ui/NewsCard.astro";

export function getStaticPaths() {
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const related = articles.filter((a) => a.slug !== article.slug).slice(0, 3);
---

<Shell title={`${article.title} — Museum Aceh News`} description={article.excerpt}>
  <article class="mx-auto w-full max-w-3xl px-4 pt-36 sm:pt-44">
    <a
      href="/news"
      class="inline-flex items-center gap-2 font-montserrat text-xs uppercase tracking-[0.2em] text-taupe transition-colors hover:text-coffee"
      data-hero-fade
    >
      <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M19 12H5m7-7l-7 7 7 7"></path>
      </svg>
      Back to news
    </a>

    <header class="mt-10 text-center">
      <div
        class="flex items-center justify-center gap-3 font-montserrat text-xs tracking-[0.25em] uppercase text-taupe"
        data-hero-fade
      >
        <span>{article.category}</span>
        <span class="h-px w-6 bg-sand"></span>
        <span class="text-mist">{article.date}</span>
      </div>
      <h1 class="mt-6 font-cinzel text-3xl leading-snug sm:text-5xl" data-hero-fade>
        {article.title}
      </h1>
      <p class="mx-auto mt-6 max-w-xl leading-relaxed text-coal/65" data-hero-fade>
        {article.excerpt}
      </p>
    </header>

    <figure class="relative mt-14 aspect-[16/9] overflow-hidden bg-sand/30" data-hero-fade>
      <img
        src={img(article.seed, 1200, 675)}
        alt={article.title}
        data-parallax="0.07"
        class="h-[115%] w-full object-cover"
      />
    </figure>

    <div class="mx-auto max-w-2xl space-y-6 py-16 text-lg leading-relaxed text-coal/80">
      {article.body.map((p) => <p data-reveal>{p}</p>)}

      <div class="border-t border-black/10 pt-8" data-reveal>
        <p class="font-montserrat text-xs uppercase tracking-[0.25em] text-mist">
          Published by Museum Aceh · {article.date}
        </p>
      </div>
    </div>
  </article>

  <section class="border-t border-black/10 bg-cream">
    <div class="mx-auto w-full max-w-6xl px-4 py-20 sm:py-24">
      <h2 class="font-cinzel text-2xl sm:text-3xl">More stories</h2>
      <div class="mt-10 grid gap-6 sm:grid-cols-3" data-reveal-stagger data-reveal-stagger-step="0.1">
        {
          related.map((a) => (
            <NewsCard {...a} href={`/news/${a.slug}`} />
          ))
        }
      </div>
    </div>
  </section>
</Shell>
