---
import { img } from "../../lib/img";

const items = [
  { seed: "hg-kris", title: "Kris of the Sultanate", year: "c. 1600" },
  { seed: "hg-cakra", title: "Cakra Donya Bell", year: "15th century" },
  { seed: "hg-zirah", title: "War Vest (Bulu Badan)", year: "1874" },
  { seed: "hg-nisan", title: "Royal Gravestone", year: "16th century" },
  { seed: "hg-keramik", title: "Ming Dynasty Ceramics", year: "1368–1644" },
  { seed: "hg-emas", title: "Gold Ornaments", year: "Aceh Sultanate" },
];
---

<section data-hscroll-section class="relative overflow-hidden bg-ink text-cream">
  <div class="flex h-svh flex-col justify-center">
    <div class="mx-auto w-full max-w-6xl px-4 pb-10 sm:pb-14">
      <p class="font-montserrat text-xs tracking-[0.35em] uppercase text-taupe">Treasures</p>
      <h2 class="mt-4 font-cinzel text-3xl sm:text-5xl">
        Scroll through centuries <span class="text-taupe">→</span>
      </h2>
    </div>

    <!-- pinned horizontal track -->
    <div data-hscroll-track class="flex w-max items-stretch gap-6 pl-[max(1rem,calc((100vw-72rem)/2+1rem))] pr-12">
      {
        items.map((it, i) => (
          <figure
            class={`group relative w-[70vw] shrink-0 overflow-hidden sm:w-[42vw] lg:w-[30rem] ${i % 2 === 1 ? "lg:translate-y-8" : ""}`}
          >
            <img
              src={img(it.seed, 700, 900)}
              alt={it.title}
              loading="lazy"
              class="aspect-[3/4] h-full max-h-[60svh] w-full object-cover transition-transform duration-700 group-hover:scale-105"
            />
            <figcaption class="absolute right-6 bottom-6 left-6 bg-black/50 p-5 backdrop-blur-sm">
              <span class="font-montserrat text-[10px] uppercase tracking-[0.3em] text-taupe">{it.year}</span>
              <p class="mt-1 font-cinzel text-xl">{it.title}</p>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { gsap, ScrollTrigger } from "../../lib/animations";

  const section = document.querySelector<HTMLElement>("[data-hscroll-section]")!;
  const track = section.querySelector<HTMLElement>("[data-hscroll-track]")!;

  const distance = () => track.scrollWidth - window.innerWidth;

  gsap.to(track, {
    x: () => -distance(),
    ease: "none",
    scrollTrigger: {
      trigger: section,
      start: "top top",
      end: () => `+=${distance()}`,
      pin: true,
      scrub: 1,
      invalidateOnRefresh: true,
      anticipatePin: 1,
    },
  });
</script>
