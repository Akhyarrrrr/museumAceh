---
import { img } from "../../lib/img";
import SectionHeading from "../ui/SectionHeading.astro";

const categories = ["All", "Artifacts", "Heritage", "Manuscripts", "Numismatics", "Fine Arts"];

const items = [
  { seed: "col-rencong", title: "Rencong", cat: "Artifacts", era: "Aceh Sultanate" },
  { seed: "col-naskah", title: "Hikayat Aceh Manuscript", cat: "Manuscripts", era: "17th century" },
  { seed: "col-koin", title: "Dirham Dirang", cat: "Numismatics", era: "1514–1528" },
  { seed: "col-pintu", title: "Pinto Khoe Gate", cat: "Heritage", era: "19th century" },
  { seed: "col-lukisan", title: "Portrait of Cut Nyak Dhien", cat: "Fine Arts", era: "1945" },
  { seed: "col-topi", title: "Ceremonial Headdress", cat: "Artifacts", era: "18th century" },
];
---

<section class="mx-auto w-full max-w-6xl px-4 py-24 sm:py-32">
  <SectionHeading
    eyebrow="The collection"
    title="Objects that carry memory"
    description="From sultanate gold to war relics — each object is a witness of Aceh's long story."
  />

  <!-- filter chips (UI only) -->
  <div class="mt-12 flex flex-wrap gap-3" data-reveal>
    {
      categories.map((c, i) => (
        <button
          class={`rounded-full px-5 py-2 font-montserrat text-xs uppercase tracking-[0.2em] transition-colors duration-300 ${
            i === 0
              ? "bg-coffee text-cream"
              : "border border-black/15 text-coal/70 hover:border-coffee hover:text-coffee"
          }`}
        >
          {c}
        </button>
      ))
    }
  </div>

  <div class="mt-10 grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3" data-reveal-stagger data-reveal-stagger-step="0.1">
    {
      items.map((it) => (
        <a href="#" class="group block">
          <div class="relative aspect-[4/5] overflow-hidden bg-sand/30">
            <img
              src={img(it.seed, 600, 750)}
              alt={it.title}
              loading="lazy"
              class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
            />
            <span class="absolute top-4 left-4 bg-cream px-3 py-1 font-montserrat text-[10px] uppercase tracking-[0.25em] text-coal">
              {it.cat}
            </span>
          </div>
          <div class="mt-4 flex items-start justify-between gap-4">
            <div>
              <h3 class="font-cinzel text-lg transition-colors group-hover:text-coffee">{it.title}</h3>
              <p class="mt-1 font-montserrat text-xs uppercase tracking-widest text-mist">{it.era}</p>
            </div>
            <svg viewBox="0 0 24 24" class="mt-1 h-4 w-4 shrink-0 text-taupe opacity-0 transition-all duration-300 group-hover:translate-x-1 group-hover:opacity-100" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M7 17L17 7M9 7h8v8"></path>
            </svg>
          </div>
        </a>
      ))
    }
  </div>
</section>
