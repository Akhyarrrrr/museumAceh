---
import { img } from "../../lib/img";
import SectionHeading from "../ui/SectionHeading.astro";

const galleries = [
  { no: "01", name: "Main Pavilion", desc: "The historic 1915 pavilion and its permanent exhibition." },
  { no: "02", name: "Sultanate Room", desc: "Gold, regalia and courtly life of the Aceh Sultanate." },
  { no: "03", name: "War & Resistance", desc: "Relics from the Aceh War and stories of its heroes." },
  { no: "04", name: "Maritime Trade", desc: "Ceramics and cargo of the Malacca Strait routes." },
  { no: "05", name: "Manuscript Gallery", desc: "Illuminated texts in Malay, Arabic and Acehnese." },
];
---

<section id="galleries" class="mx-auto w-full max-w-6xl px-4 py-24 sm:py-32">
  <SectionHeading eyebrow="Permanent galleries" title="Twelve rooms, one long story" />

  <div class="relative mt-14">
    <!-- floating preview image (desktop) -->
    <div class="pointer-events-none absolute top-0 right-0 hidden h-72 w-96 -translate-y-8 opacity-0 transition-all duration-500 lg:block" data-gallery-preview>
      <img src={img("galeri-utama", 600, 450)} alt="" class="h-full w-full object-cover shadow-2xl" />
    </div>

    <ul class="divide-y divide-black/10 border-y border-black/10">
      {
        galleries.map((g) => (
          <li data-reveal>
            <a
              href="#"
              class="group flex items-baseline gap-6 py-7 transition-colors sm:gap-10"
              data-preview-seed={`galeri-${g.no}`}
            >
              <span class="font-montserrat text-xs tracking-[0.3em] text-taupe">{g.no}</span>
              <div class="flex-1">
                <h3 class="font-cinzel text-2xl transition-transform duration-300 group-hover:translate-x-2 group-hover:text-coffee sm:text-3xl">
                  {g.name}
                </h3>
                <p class="mt-1 text-sm text-coal/50">{g.desc}</p>
              </div>
              <svg viewBox="0 0 24 24" class="h-5 w-5 shrink-0 self-center text-taupe opacity-0 transition-all duration-300 group-hover:translate-x-2 group-hover:opacity-100" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M13 5l7 7-7 7"></path>
              </svg>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  // swap the floating preview image as rows are hovered (desktop only)
  const preview = document.querySelector<HTMLElement>("[data-gallery-preview]");
  if (preview && window.matchMedia("(min-width: 1024px)").matches) {
    const imgEl = preview.querySelector("img")!;
    document.querySelectorAll<HTMLElement>("[data-preview-seed]").forEach((row) => {
      row.addEventListener("mouseenter", () => {
        imgEl.src = `https://picsum.photos/seed/${row.dataset.previewSeed}/600/450`;
        preview.style.opacity = "1";
      });
    });
    preview.closest("section")!.addEventListener("mouseleave", () => {
      preview.style.opacity = "0";
    });
  }
</script>
