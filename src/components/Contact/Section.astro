---
import SectionHeading from "../ui/SectionHeading.astro";

const channels = [
  { label: "Visit us", value: "Jl. Sultan Alauddin Mahmudsyah No. 8, Banda Aceh 23127" },
  { label: "Call us", value: "(0651) 22128 — Mon to Sun, 08.30–16.15" },
  { label: "Email us", value: "info@museumaceh.id" },
];
---

<section class="mx-auto w-full max-w-6xl px-4 py-24 sm:py-32">
  <div class="grid gap-14 lg:grid-cols-[1fr_1.2fr] lg:gap-20">
    <!-- info -->
    <div>
      <SectionHeading
        eyebrow="Contact"
        title="Say hello"
        description="Questions about visits, research access or group programs? We usually reply within one working day."
      />
      <dl class="mt-12 space-y-8">
        {
          channels.map((c) => (
            <div data-reveal class="border-b border-black/10 pb-6">
              <dt class="font-montserrat text-xs uppercase tracking-[0.3em] text-taupe">{c.label}</dt>
              <dd class="mt-2 text-sm leading-relaxed text-coal/80">{c.value}</dd>
            </div>
          ))
        }
      </dl>
      <div data-reveal class="mt-10 overflow-hidden grayscale-[40%]">
        <img src="https://picsum.photos/seed/peta-kontak/700/400" alt="Map of Museum Aceh surroundings" loading="lazy" class="w-full object-cover" />
      </div>
    </div>

    <!-- form (UI only) -->
    <form
      data-reveal
      class="bg-paper p-8 shadow-lg sm:p-10"
      onsubmit="return false"
      aria-label="Contact form"
    >
      <div class="grid gap-6 sm:grid-cols-2">
        <label class="block">
          <span class="font-montserrat text-xs uppercase tracking-[0.25em] text-coal/60">Full name</span>
          <input
            type="text"
            required
            placeholder="Your name"
            class="mt-2 w-full border-0 border-b border-black/20 bg-transparent py-3 text-sm outline-none transition-colors placeholder:text-sand focus:border-coffee"
          />
        </label>
        <label class="block">
          <span class="font-montserrat text-xs uppercase tracking-[0.25em] text-coal/60">Email</span>
          <input
            type="email"
            required
            placeholder="you@example.com"
            class="mt-2 w-full border-0 border-b border-black/20 bg-transparent py-3 text-sm outline-none transition-colors placeholder:text-sand focus:border-coffee"
          />
        </label>
      </div>
      <label class="mt-8 block">
        <span class="font-montserrat text-xs uppercase tracking-[0.25em] text-coal/60">Topic</span>
        <select class="mt-2 w-full border-0 border-b border-black/20 bg-transparent py-3 text-sm outline-none transition-colors focus:border-coffee">
          <option>General inquiry</option>
          <option>Group booking</option>
          <option>Research access</option>
          <option>Press & media</option>
        </select>
      </label>
      <label class="mt-8 block">
        <span class="font-montserrat text-xs uppercase tracking-[0.25em] text-coal/60">Message</span>
        <textarea
          rows="5"
          required
          placeholder="Write your message…"
          class="mt-2 w-full resize-none border-0 border-b border-black/20 bg-transparent py-3 text-sm outline-none transition-colors placeholder:text-sand focus:border-coffee"></textarea>
      </label>
      <div class="mt-10 flex flex-wrap items-center justify-between gap-4">
        <p class="max-w-xs font-montserrat text-[11px] leading-relaxed text-mist">
          By sending this form you agree to our privacy policy.
        </p>
        <button
          type="submit"
          class="inline-flex items-center gap-3 rounded-full bg-coffee px-7 py-3.5 font-montserrat text-sm tracking-wide text-cream transition-colors duration-300 hover:bg-ink"
        >
          Send message
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M13 5l7 7-7 7"></path>
          </svg>
        </button>
      </div>
    </form>
  </div>
</section>
