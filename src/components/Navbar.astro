---
import logoFull from "../assets/images/logoFull.png";
import SearchOverlay from "./SearchOverlay.astro";

const { pathname } = Astro.url;

const nav = [
  { href: "/", label: "Home" },
  { href: "/visit", label: "Visit" },
  { href: "/collection", label: "Collection" },
  { href: "/explore", label: "Explore" },
  { href: "/about", label: "About" },
  { href: "/whats-on", label: "What's On" },
  { href: "/news", label: "News" },
  { href: "/contact", label: "Contact" },
];

const isActive = (href: string) =>
  (href === "/" && pathname === "/") ||
  (href !== "/" && pathname.startsWith(href));
---

<header id="site-nav" class="fixed inset-x-0 top-0 z-50 transition-transform duration-500 will-change-transform">
  <div class="bg-black/90 text-white backdrop-blur-md">
    <!-- Top row -->
    <div class="mx-auto w-full max-w-6xl px-4">
      <div class="flex h-16 items-center justify-between">
        <!-- left: search -->
        <button id="search-open" aria-label="Search" class="p-2 transition-opacity hover:opacity-70">
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="7"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </button>

        <!-- center: logo -->
        <a href="/" class="flex flex-col items-center">
          <img src={logoFull.src} alt="Museum Aceh" class="h-12 w-auto sm:h-14" />
        </a>

        <!-- right: CTA / hamburger -->
        <div class="flex items-center gap-3 font-montserrat">
          <a
            href="/signup"
            class="hidden rounded-full border border-white/20 px-5 py-2 text-sm text-white transition-colors hover:bg-white hover:text-black sm:inline-block"
            >Sign Up</a
          >
          <a
            href="/login"
            class="hidden rounded-full bg-coffee px-5 py-2 text-sm text-white transition-colors hover:bg-taupe sm:inline-block"
            >Login</a
          >
          <button
            id="nav-burger"
            aria-label="Open menu"
            aria-expanded="false"
            class="flex h-10 w-10 flex-col items-center justify-center gap-[5px] lg:hidden"
          >
            <span class="burger-line block h-px w-6 bg-white transition-all duration-300"></span>
            <span class="burger-line block h-px w-6 bg-white transition-all duration-300"></span>
            <span class="burger-line block h-px w-6 bg-white transition-all duration-300"></span>
          </button>
        </div>
      </div>
    </div>

    <div class="border-t border-white/10"></div>

    <!-- second row: nav links (desktop) -->
    <div class="mx-auto hidden w-full max-w-6xl px-4 lg:block">
      <nav class="flex h-12 items-center justify-center gap-8">
        {
          nav.map((i) => (
            <a
              href={i.href}
              class={`group relative pb-1 font-montserrat text-xs uppercase tracking-[0.25em] text-gray-400 transition-colors duration-300 hover:text-white ${
                isActive(i.href) ? "text-white" : ""
              }`}
            >
              {i.label}
              <span
                class={`absolute -bottom-[1px] left-0 h-px bg-white transition-all duration-300 ${
                  isActive(i.href) ? "w-full" : "w-0 group-hover:w-full"
                }`}
              />
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</header>

<SearchOverlay />

<!-- Mobile drawer -->
<div id="mobile-drawer" class="fixed inset-0 z-[60] invisible opacity-0 lg:hidden">
  <div class="absolute inset-0 bg-ink/95 backdrop-blur-sm" data-drawer-bg></div>
  <div class="relative flex h-full flex-col justify-between px-8 pt-28 pb-12">
    <button
      id="drawer-close"
      aria-label="Close menu"
      class="absolute top-5 right-5 flex h-11 w-11 items-center justify-center rounded-full border border-white/20 text-cream"
    >
      <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
    <nav class="flex flex-col gap-1">
      {
        nav.map((i) => (
          <a
            href={i.href}
            data-drawer-link
            class={`font-cinzel text-3xl leading-snug transition-colors ${isActive(i.href) ? "text-taupe" : "text-cream hover:text-taupe"}`}
          >
            {i.label}
          </a>
        ))
      }
    </nav>
    <div class="flex gap-3 font-montserrat" data-drawer-link>
      <a href="/signup" class="flex-1 rounded-full border border-white/25 px-5 py-3 text-center text-sm text-cream">
        Sign Up
      </a>
      <a href="/login" class="flex-1 rounded-full bg-coffee px-5 py-3 text-center text-sm text-cream">
        Login
      </a>
    </div>
  </div>
</div>

<script>
  import { gsap } from "../lib/animations";
  import { getLenis } from "../lib/animations";

  const header = document.getElementById("site-nav")!;
  const burger = document.getElementById("nav-burger")!;
  const closeBtn = document.getElementById("drawer-close")!;
  const drawer = document.getElementById("mobile-drawer")!;
  const links = drawer.querySelectorAll("[data-drawer-link]");

  // hide on scroll down, show on scroll up
  let lastY = window.scrollY;
  window.addEventListener(
    "scroll",
    () => {
      const y = window.scrollY;
      if (y > 240 && y > lastY) header.style.transform = "translateY(-100%)";
      else header.style.transform = "translateY(0)";
      lastY = y;
    },
    { passive: true },
  );

  let open = false;
  const tl = gsap.timeline({ paused: true });
  tl.set(drawer, { visibility: "visible" })
    .to(drawer, { opacity: 1, duration: 0.3 })
    .fromTo(
      links,
      { opacity: 0, x: -32 },
      { opacity: 1, x: 0, duration: 0.5, ease: "power3.out", stagger: 0.06 },
      "-=0.1",
    );

  function toggleDrawer(force: boolean) {
    open = force ?? !open;
    burger.setAttribute("aria-expanded", String(open));
    if (open) {
      tl.play();
      document.documentElement.classList.add("lenis-stopped");
      getLenis()?.stop();
    } else {
      tl.reverse();
      getLenis()?.start();
    }
  }

  burger.addEventListener("click", () => toggleDrawer(true));
  closeBtn.addEventListener("click", () => toggleDrawer(false));
  links.forEach((l) => l.addEventListener("click", () => toggleDrawer(false)));

  // search overlay trigger
  const searchBtn = document.getElementById("search-open")!;
  searchBtn.setAttribute("aria-haspopup", "dialog");
  searchBtn.addEventListener("click", () =>
    window.dispatchEvent(new Event("search:open")),
  );
</script>

<style>
  /* burger morphs to X while drawer open */
  #nav-burger[aria-expanded="true"] .burger-line:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  #nav-burger[aria-expanded="true"] .burger-line:nth-child(2) {
    opacity: 0;
  }
  #nav-burger[aria-expanded="true"] .burger-line:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }
</style>
