---
import SectionHeading from "../ui/SectionHeading.astro";
import NewsCard from "../ui/NewsCard.astro";
import Button from "../ui/Button.astro";
import { articles } from "../../lib/data";

const featured = articles.slice(0, 3);
---

<section class="bg-cream">
  <div class="mx-auto w-full max-w-6xl px-4 pb-24 sm:pb-32">
    <div class="flex flex-wrap items-end justify-between gap-6 border-t border-black/10 pt-24 sm:pt-32">
      <SectionHeading eyebrow="News" title="Latest from the museum" />
      <Button href="/news" variant="outline-dark">All news</Button>
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-3" data-reveal-stagger data-reveal-stagger-step="0.15">
      {featured.map((a) => <NewsCard {...a} href={`/news/${a.slug}`} />)}
    </div>
  </div>
</section>
