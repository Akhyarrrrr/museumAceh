---
import SectionHeading from "../ui/SectionHeading.astro";
---

<section class="border-b border-black/10 py-24 sm:py-28">
  <div class="mx-auto w-full max-w-6xl px-4">
    <SectionHeading
      eyebrow="The museum in numbers"
      title="A legacy measured in stories"
      align="center"
      class="mx-auto"
    />
    <div class="mt-16 grid grid-cols-2 gap-y-12 lg:grid-cols-4" data-reveal-stagger>
      {
        [
          { value: 1915, suffix: "", label: "Established" },
          { value: 2400, suffix: "+", label: "Artefacts preserved" },
          { value: 12, suffix: "", label: "Permanent galleries" },
          { value: 85000, suffix: "+", label: "Visitors each year" },
        ].map((s) => (
          <div class="text-center">
            <p class="font-cinzel text-4xl text-coffee sm:text-5xl">
              <span data-counter={s.value}>0</span>{s.suffix}
            </p>
            <p class="mt-3 font-montserrat text-xs uppercase tracking-[0.25em] text-mist">
              {s.label}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
