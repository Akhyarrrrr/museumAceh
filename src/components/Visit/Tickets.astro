---
import SectionHeading from "../ui/SectionHeading.astro";
import Button from "../ui/Button.astro";

const tickets = [
  {
    name: "Adult",
    price: "Rp 10.000",
    note: "Domestic visitors",
    features: ["All permanent galleries", "Open-air exhibits", "Free parking"],
    featured: false,
  },
  {
    name: "International",
    price: "Rp 50.000",
    note: "Overseas visitors",
    features: [
      "All permanent galleries",
      "Open-air exhibits",
      "Audio guide included",
    ],
    featured: true,
  },
  {
    name: "Student / Child",
    price: "Rp 5.000",
    note: "With valid ID, under 17",
    features: ["All permanent galleries", "Guided school programs", "Workshop access"],
    featured: false,
  },
];
---

<section id="tickets" class="bg-ink py-24 text-cream sm:py-32">
  <div class="mx-auto w-full max-w-6xl px-4">
    <SectionHeading
      eyebrow="Tickets"
      title="Choose your pass"
      description="Buy at the door or reserve online — same price, shorter queue."
      tone="light"
    />

    <div class="mt-16 grid gap-6 lg:grid-cols-3" data-reveal-stagger>
      {
        tickets.map((t) => (
          <div
            class={`relative flex flex-col p-8 transition-transform duration-300 hover:-translate-y-2 ${
              t.featured
                ? "bg-cream text-ink"
                : "border border-white/15 bg-white/[0.03]"
            }`}
          >
            {t.featured && (
              <span class="absolute -top-3 left-8 bg-taupe px-3 py-1 font-montserrat text-[10px] uppercase tracking-[0.25em] text-cream">
                Most popular
              </span>
            )}
            <h3 class="font-cinzel text-2xl">{t.name}</h3>
            <p
              class={`mt-1 font-montserrat text-xs uppercase tracking-[0.25em] ${t.featured ? "text-taupe" : "text-cream/50"}`}
            >
              {t.note}
            </p>
            <p class="mt-6 font-cinzel text-4xl">{t.price}</p>
            <ul class={`mt-8 flex-1 space-y-3 border-t pt-6 text-sm ${t.featured ? "border-black/10 text-coal/70" : "border-white/10 text-cream/70"}`}>
              {t.features.map((f) => (
                <li class="flex items-center gap-3">
                  <svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0 text-taupe" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M5 13l4 4L19 7"></path>
                  </svg>
                  {f}
                </li>
              ))}
            </ul>
            <a
              href="#"
              class={`mt-8 rounded-full py-3.5 text-center font-montserrat text-sm transition-colors duration-300 ${
                t.featured
                  ? "bg-coffee text-cream hover:bg-ink"
                  : "border border-cream/30 hover:bg-cream hover:text-ink"
              }`}
            >
              Book now
            </a>
          </div>
        ))
      }
    </div>

    <div data-reveal class="mt-12 flex flex-wrap items-center gap-x-8 gap-y-3 font-montserrat text-xs uppercase tracking-[0.2em] text-cream/40">
      <span>Group bookings (20+): contact us</span>
      <span>Children under 5 enter free</span>
    </div>
  </div>
</section>
