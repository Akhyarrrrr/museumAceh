---
import logoFull from "../assets/images/logoFull.png";

const year = new Date().getFullYear();

const columns = [
  {
    title: "Visit",
    links: [
      { href: "/visit", label: "Plan Your Visit" },
      { href: "/visit#tickets", label: "Tickets" },
      { href: "/visit#hours", label: "Opening Hours" },
      { href: "/visit#accessibility", label: "Accessibility" },
    ],
  },
  {
    title: "Discover",
    links: [
      { href: "/collection", label: "Collection" },
      { href: "/explore", label: "Explore" },
      { href: "/whats-on", label: "What's On" },
      { href: "/news", label: "News" },
    ],
  },
  {
    title: "Museum",
    links: [
      { href: "/about", label: "About Us" },
      { href: "/contact", label: "Contact" },
      { href: "/login", label: "Login" },
      { href: "/signup", label: "Sign Up" },
    ],
  },
];
---

<footer class="bg-ink text-cream">
  <div class="mx-auto w-full max-w-6xl px-4 py-16 sm:py-20">
    <div class="grid gap-12 lg:grid-cols-[1.2fr_2fr]">
      <!-- brand -->
      <div data-reveal>
        <img src={logoFull.src} alt="Museum Aceh" class="h-16 w-auto" />
        <p class="mt-6 max-w-xs text-sm leading-relaxed text-cream/60">
          Guarding the heritage of Aceh — history, culture and resilience under
          one roof since 1915.
        </p>
        <div class="mt-6 flex gap-3">
          {
            ["Instagram", "Facebook", "X", "Youtube"].map((s) => (
              <a
                href="#"
                aria-label={s}
                class="flex h-10 w-10 items-center justify-center rounded-full border border-white/15 font-montserrat text-[10px] uppercase tracking-widest transition-colors hover:border-taupe hover:text-taupe"
              >
                {s.slice(0, 2)}
              </a>
            ))
          }
        </div>
      </div>

      <!-- link columns -->
      <div class="grid grid-cols-2 gap-8 sm:grid-cols-3" data-reveal-stagger>
        {
          columns.map((col) => (
            <div>
              <h3 class="font-montserrat text-xs uppercase tracking-[0.3em] text-taupe">
                {col.title}
              </h3>
              <ul class="mt-5 space-y-3">
                {col.links.map((l) => (
                  <li>
                    <a
                      href={l.href}
                      class="text-sm text-cream/70 transition-colors hover:text-cream"
                    >
                      {l.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div class="mt-16 flex flex-col items-center justify-between gap-4 border-t border-white/10 pt-8 font-montserrat text-xs text-cream/40 sm:flex-row">
      <p>© {year} Museum Aceh. All rights reserved.</p>
      <p>Banda Aceh, Indonesia</p>
    </div>
  </div>
</footer>
